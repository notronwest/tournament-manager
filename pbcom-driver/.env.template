# ── pbcom-driver environment ────────────────────────────────────────────────
# Copy to `.env` on the driver host (the club Mac mini). NEVER commit `.env`.
# The driver drives PickleballBrackets.com as the ORG's OWN PB.com account
# (D-0045): the same actions a human tournament director performs, no public API.

# PB.com credentials — the org's own PB.com login. PB.com auth is email → one-time
# CODE (there is no password to fill from a secret), so login is SUPERVISED: run
# headed with PBCOM_PROFILE_DIR set and complete the emailed code once; the session
# is then reused across runs. PBCOM_USERNAME pre-fills the email field to speed that.
PBCOM_BASE_URL=https://pickleballbrackets.com
PBCOM_USERNAME=
PBCOM_PASSWORD=

# A persistent Chrome profile dir. STRONGLY recommended for supervised runs: the
# operator completes the email-code login once and it persists here. Unset → a
# throwaway profile each run (code must be re-entered every run).
# PBCOM_PROFILE_DIR=/Users/<you>/.local/state/wmpc-pbcom/chrome-profile

# How long login() waits for the supervised operator to finish the code step (ms).
# PBCOM_LOGIN_TIMEOUT_MS=180000

# ── Draw source (READ-ONLY) ─────────────────────────────────────────────────
# The driver reads the B&E draw/matches from the tournament-manager Supabase
# project using the SERVICE-ROLE key. Missing → "no-credential skip" (exit 2).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (Legacy/optional direct DB URL; the DbDrawSource uses SUPABASE_* above.)
PBCOM_DB_URL=

# Singleton gate. Only the host named in the committed PBCOM-PUSH-HOST fact drives.
# This var is an escape hatch for local dev only; production relies on the fact file.
# PBCOM_PUSH_FORCE_HOST=0

# Browser channel. Default prefers the real installed Google Chrome (version-drift
# immunity — see courtreserve-api client.py). Set to "chromium" to force Playwright's
# managed build.
# PBCOM_BROWSER_CHANNEL=chrome

# headless breaks bot-management on WebForms sites (learned on Court Reserve); keep
# the driver on a real headed Chrome on the club's residential IP.
# PBCOM_HEADLESS=0

# Structured-log level: debug | info | warn | error
PBCOM_LOG_LEVEL=info

# Path to the declarative event↔eid binding config (see binding.example.json).
PBCOM_BINDING_PATH=./binding.json

# ── Unattended auto/poll loop (launchd) ──────────────────────────────────────
# Discord webhook for needs_attention alerts from the UNATTENDED `poll` loop: a
# lapsed PB.com session (re-auth needed) or a write that would not verify ("PB.com
# out of sync", D-0045). Unset → the loop LOGS the alert loudly and skips the post
# (it still records needs_attention in the DB and exits cleanly — never crashes).
PBCOM_DISCORD_WEBHOOK=
