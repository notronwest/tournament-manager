# ── pbcom-driver environment ────────────────────────────────────────────────
# Copy to `.env` on the driver host (the club Mac mini). NEVER commit `.env`.
# The driver drives PickleballBrackets.com as the ORG's OWN PB.com account
# (D-0045): the same actions a human tournament director performs, no public API.

# PB.com credentials — the org's own PB.com login. One account per org; for WMPC
# there is one. (Selectors for the login form are filled from the trace — see
# src/pbcom/session.ts.)
PBCOM_BASE_URL=https://pickleballbrackets.com
PBCOM_USERNAME=
PBCOM_PASSWORD=

# Where the driver reads the B&E draw/matches from. The mini already holds the
# fleet's DB URLs; this points at the tournament-manager Supabase project.
# Missing → the driver exits with the "no-credential skip" code (2), never crashes.
PBCOM_DB_URL=

# Singleton gate. Only the host named in the committed PBCOM-PUSH-HOST fact drives.
# This var is an escape hatch for local dev only; production relies on the fact file.
# PBCOM_PUSH_FORCE_HOST=0

# Browser channel. Default prefers the real installed Google Chrome (version-drift
# immunity — see courtreserve-api client.py). Set to "chromium" to force Playwright's
# managed build.
# PBCOM_BROWSER_CHANNEL=chrome

# headless breaks bot-management on WebForms sites (learned on Court Reserve); keep
# the driver on a real headed Chrome on the club's residential IP.
# PBCOM_HEADLESS=0

# Structured-log level: debug | info | warn | error
PBCOM_LOG_LEVEL=info

# Path to the declarative event↔eid binding config (see binding.example.json).
PBCOM_BINDING_PATH=./binding.json
