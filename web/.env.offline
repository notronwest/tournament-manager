# Loaded automatically by `vite --mode offline` (see ../scripts/offline.sh).
# Marks the app as running in offline/local-Postgres mode — surfaces the
# "OFFLINE" env banner via src/lib/env.ts, same mechanism as the existing
# "TEST" banner. Safe to commit: no secrets.
#
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are NOT set here — they come
# from the local Supabase stack and are written at runtime to the gitignored
# web/.env.offline.local (see scripts/offline.sh), never hardcoded in a
# committed file.
VITE_APP_ENV=offline
